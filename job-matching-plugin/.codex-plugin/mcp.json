{
  "mcpServers": {
    "facebook_crawler": {
      "command": "cmd.exe",
      "args": [
        "/d",
        "/s",
        "/c",
        "call",
        "./scripts/launch_facebook_crawler_mcp.cmd"
      ],
      "cwd": ".",
      "enabled": true,
      "default_tools_approval_mode": "approve",
      "startup_timeout_sec": 15,
      "tool_timeout_sec": 1800
    }
  }
}
